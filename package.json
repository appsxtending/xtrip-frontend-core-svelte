{
  "name": "@xtrip/ui-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "npm run build:packages && vite build && svelte-package",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "check": "npm run check:packages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=foundation",
    "verify": "npm run check:api && npm run lint && npm run check && npm test && npm run build && npm run test:e2e",
    "generate:api": "node tools/generate-api.mjs",
    "check:api": "node tools/generate-api.mjs --check && node tools/check-api-contract.mjs",
    "build:packages": "npm run build --workspaces",
    "check:packages": "npm run check --workspaces",
    "test:api:real": "playwright test --project=real-api",
    "check:api:strict": "node tools/generate-api.mjs --check && node tools/check-api-contract.mjs --strict",
    "verify:release": "npm run check:api:strict && npm run verify && npm run test:api:real"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "open-props": "1.7.23",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "msw": "2.15.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "3.0.0",
    "svelte": "5.57.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
